# Email verification via Resend HTTP API (works on Render Free)
RESEND_API_KEY=re_your_resend_api_key
# For testing use: StayNest <onboarding@resend.dev>
# For production, use an address on a domain verified in Resend.
RESEND_FROM=StayNest <onboarding@resend.dev>

# Public frontend URL used in verification links
FRONTEND_URL=https://staynesthotel.vercel.app

# Existing required backend settings
MONGO_DB_URL=your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=adarshkumardubey2323@gmail.com
NODE_ENV=production
